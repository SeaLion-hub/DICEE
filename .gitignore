# Virtual (.venv-* = CI/metric/mypy-test 등 로컬 전용 venv)
.venv/
.venv-*/
venv/
ENV/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Test / Coverage
.pytest_cache/
.coverage
htmlcov/

# Type check / lint caches
.mypy_cache/
.ruff_cache/

# gstack (vendored under .agents/skills/gstack; run setup after clone)
.agents/skills/gstack/node_modules/
.agents/skills/gstack/browse/dist/
.agents/skills/gstack/bin/*.exe
# Nested vendored gstack copy: compiled discover binaries exceed GitHub 100MB limit
.agents/skills/gstack/.agents/skills/gstack/bin/gstack-global-discover
.agents/skills/gstack/.agents/skills/gstack/bin/gstack-global-discover.exe
.agents/skills/gstack/*.bun-build
# Symlinks/copies created by ./setup --host codex at repo root (skills live under gstack/.agents/skills/)
.agents/skills/gstack-*/

# Static analysis / local metric reports (radon, xenon)
radon_*.txt
xenon_*.txt

# Misc
.DS_Store
Thumbs.db
Desktop.ini
# Local PR / diff exports (e.g. git diff > pr_diff.patch)
*.patch
*.diff
tmp/
dispatch_repo
.cursor/debug.log
.cursor/*.log

# Local scratch / redirected test output (do not commit)
/status.txt
pytest_errors.log

# 벤치마크 인사이트 (참고용, 커밋 제외)
docs/reports/BENCHMARK_INSIGHTS.md
tmp_*/
_tmp*/
tmp_*.txt
*.tmp
# 루트 로컬 업로드/스풀만 제외 (app/core/storage 패키지는 추적)
/storage/
