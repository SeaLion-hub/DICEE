# DICEE Backend - 환경 변수 예시
# 키 이름만 기재. 값은 로컬 .env 또는 Railway Variables에 설정.
# 복사: cp .env.example .env 후 값 채우기.
#
# 프로덕션: Secret Manager(Vault, Railway Variables, AWS Secrets Manager 등) 사용 권장.
# 이 파일을 복사한 .env에 실제 시크릿 값을 붙여넣은 채 커밋·공유하지 말 것(유출 위험).
# config.py: environment=production 이면 DATABASE_URL, REDIS_URL, JWT_SECRET, GOOGLE_* 필수(Fail-Fast).

# 진입점. api=웹 서비스(FastAPI), celery=워커/beat. 필수(Fail-fast). APP_ENTRY 또는 ROLE.
APP_ENTRY=api

# 1단계
SENTRY_DSN=

# 2단계~
DATABASE_URL=
DB_CONNECT_RETRIES=
DB_CONNECT_RETRY_INTERVAL_SEC=

# 2단계 Auth
JWT_SECRET=
# JWT signing mode: auto|hs256|rs256 (default auto, RS-first in auto mode).
JWT_SIGNING_MODE=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ACCESS_EXPIRE_SECONDS=
JWT_REFRESH_EXPIRE_DAYS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 허용 redirect_uri 목록(쉼표 구분). 비어 있으면 검사 생략. 프로덕션 배포 시 반드시 설정 권장. 예: http://localhost:3000/callback
GOOGLE_REDIRECT_URIS=
AUTH_GOOGLE_RATE_LIMIT_PER_MINUTE=
AUTH_REFRESH_RATE_LIMIT_PER_MINUTE=
AUTH_REFRESH_TOKEN_FINGERPRINT_RATE_LIMIT_PER_MINUTE=
# 리버스 프록시 직전 피어 IP(쉼표 구분). 비어 있으면 X-Forwarded-For 미신뢰. 프로덕션에서는 비어 있으면 부팅 실패(Fail-fast).
TRUSTED_PROXY_IPS=
# 프로덕션에서 TRUSTED_PROXY_IPS 비어 있어도 부팅 허용. 프록시 뒤에 두지 않는 프로덕션만 1로 설정.
# TRUSTED_PROXY_SKIP_FAST=

# 3단계~
REDIS_URL=
# Celery broker/result_backend 전용. 비어 있으면 REDIS_URL 사용. 워커 시작 시 -Q critical,crawl,ai 필수.
# REDIS_CELERY_URL=
# Blocklist: Redis 장애 시 True=인증 거부(Fail-Closed), False=서명만 검증 후 통과(Fail-Open). 프로덕션 권장: true.
REDIS_BLOCKLIST_FAIL_CLOSED=
# 레이트리밋: True면 Redis 없/장애 시 503. 멀티 인스턴스 운영 시 true 권장.
API_RATE_LIMIT_REQUIRE_REDIS=
# Blocklist용 Redis 풀 크기. Uvicorn 동시 처리량에 맞게 설정.
REDIS_BLOCKLIST_MAX_CONNECTIONS=
CRAWL_TRIGGER_SECRET=
# 요청/페이지 간 최소 딜레이(초). 대상 서버 부하·IP 차단 완화. 기본 1.
POLITE_DELAY_SECONDS=
CRAWL_PAGE_TIMEOUT_SECONDS=
CRAWL_UPSERT_CHUNK_SIZE=
CRAWL_COLLECT_SYNC_MAX_WORKERS=
CRAWL_COLLECT_IN_FLIGHT_LIMIT=
CRAWL_MAX_LINKS_PER_RUN=
CRAWL_COLLECT_ASYNC_CONCURRENCY=
# GET /internal/metrics 허용 IP(쉼표 구분). 비우면 모든 IP 차단(fail-closed). Prometheus 스크래핑 제한용. 예: 127.0.0.1,10.0.0.5
METRICS_ALLOWED_IPS=
# 본문 업로드 실패 스풀. 프로덕션: CONTENT_UPLOAD_FAILURE_POLICY=fail, 스풀은 영속 볼륨 또는 CONTENT_SPOOL_BACKEND 설정.
# CONTENT_SPOOL_DIR=
# CONTENT_SPOOL_BACKEND=local
# CONTENT_SPOOL_ALLOW_EPHEMERAL=false
# CONTENT_SPOOL_S3_PREFIX=content-spool
# CONTENT_SPOOL_MAX_RETRIES=5
# 읽기 캐시 TTL(초). crawl-stats 등. 기본 60.
# READ_CACHE_TTL_SECONDS=60
# READ_CACHE_KEY_PREFIX=read_cache:
# 자율 모드 전환: 연속 실패 N회 → DEGRADED, 연속 성공 M회 → NORMAL.
# DEGRADED_FAILURE_THRESHOLD=3
# DEGRADED_RECOVERY_SUCCESS_COUNT=5

# 6단계 프론트 연동 시
ALLOWED_ORIGINS=
