# DICEE Backend - 환경 변수 예시
# 키 이름만 기재. 값은 로컬 .env 또는 Railway Variables에 설정.
# 복사: cp .env.example .env 후 값 채우기.
#
# 프로덕션: Secret Manager(Vault, Railway Variables, AWS Secrets Manager 등) 사용 권장.
# 이 파일을 복사한 .env에 실제 시크릿 값을 붙여넣은 채 커밋·공유하지 말 것(유출 위험).
#
# === 환경별 요약 ===
# [Development] ENVIRONMENT 미설정 또는 development → production 전용 검사 없음. DB/Redis 등만 있으면 기동 가능.
# [Production]  ENVIRONMENT=production → 아래 "Production 필수" 항목이 모두 설정되어야 부팅 성공(Fail-Fast).
#              베타·운영 서버는 반드시 ENVIRONMENT=production 설정.

# ------------------------------------------------------------------------------
# 실행 환경
# ------------------------------------------------------------------------------
# 기능: development(기본) | production. 로컬/스테이징은 development, 배포 서버는 production.
# Production: 반드시 production 로 설정. 미설정 시 development 로 동작하여 production 필수 검사가 적용되지 않음.
# Railway 배포 시: ENVIRONMENT=production 설정 권장(Production Fail-Fast·USER_ID_HMAC_KEY 등 적용).
ENVIRONMENT=development

# 기능: 진입점 구분. api=FastAPI 웹 서비스, celery=Celery 워커/beat. 배포 시 각 서비스에 맞게 설정.
# Production: 필수. API 컨테이너는 api, 워커 컨테이너는 celery. (APP_ENTRY 또는 ROLE)
# APP_ENTRY: api | celery | migrate
APP_ENTRY=api

# ------------------------------------------------------------------------------
# 1단계 - 모니터링
# ------------------------------------------------------------------------------
# 기능: Sentry DSN. 에러/성능 이벤트 전송. 비우면 Sentry 비활성화.
# Production: 선택(권장). 설정 시 예외 추적·성능 모니터링 가능.
SENTRY_DSN=

# 기능: Sentry release 식별자(버전·git SHA 등). 비우면 Sentry 기본값 사용. 이슈/이벤트에서 배포 버전 추적용.
# Production: 선택. 설정 시 Sentry 대시보드에서 release 태그로 필터·그룹핑 가능.
# SENTRY_RELEASE=

# ------------------------------------------------------------------------------
# 2단계 - DB
# ------------------------------------------------------------------------------
# 기능: PostgreSQL 연결 문자열. 예: postgresql+psycopg://user:pass@host:5432/dbname
# Production: 필수. 비어 있으면 부팅 실패.
# 참고: 로컬 PostgreSQL 은 사용자 postgres 권장. role "root" 는 기본 없음.
DATABASE_URL=

# 기능: DB 연결 재시도 횟수. 기본 5.
# Production: 선택.
DB_CONNECT_RETRIES=
DB_CONNECT_RETRY_INTERVAL_SEC=

# 기능: Async API 풀 연결 재사용 시간(초). -1이면 비활성. 오래된/끊긴 연결 정리용. 기본 300.
# Production: 선택. Sync 쪽 DB_POOL_RECYCLE_SYNC와 대칭.
DB_POOL_RECYCLE_ASYNC=

# ------------------------------------------------------------------------------
# 2단계 - Auth (JWT·Google)
# ------------------------------------------------------------------------------
# 기능: JWT 서명용 비밀키(HS256). RS256 사용 시 키쌍만 있어도 됨.
# Production: 필수(API 진입점). JWT_SECRET 또는 JWT 키쌍(RS256) 중 유효한 구성 필요.
JWT_SECRET=

# 기능: JWT 서명 모드. auto | hs256 | rs256. auto 는 키쌍 있으면 RS256 우선.
# Production: 선택. 기본 auto.
JWT_SIGNING_MODE=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ACCESS_EXPIRE_SECONDS=
JWT_REFRESH_EXPIRE_DAYS=

# 기능: Google OAuth 클라이언트 ID. 구글 로그인 사용 시 설정.
# Production: GOOGLE_CLIENT_ID 또는 GOOGLE_CLIENT_SECRET 중 하나라도 있으면 GOOGLE_REDIRECT_URIS 필수.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 기능: OAuth 콜백 허용 redirect_uri 목록(쉼표 구분). 예: https://app.example.com/callback,http://localhost:3000/callback
# Production: Google 로그인 쓸 때 필수. GOOGLE_CLIENT_ID/SECRET 이 있으면 반드시 유효한 http(s) URL 설정.
GOOGLE_REDIRECT_URIS=

# 기능: 구글 로그인·state·refresh 등 레이트 리밋(분당). Redis 자원 보호.
# Production: 선택. 기본값 있음.
AUTH_GOOGLE_RATE_LIMIT_PER_MINUTE=
AUTH_GOOGLE_STATE_RATE_LIMIT_PER_MINUTE=
AUTH_REFRESH_RATE_LIMIT_PER_MINUTE=
AUTH_REFRESH_TOKEN_FINGERPRINT_RATE_LIMIT_PER_MINUTE=

# ------------------------------------------------------------------------------
# 프록시·IP
# ------------------------------------------------------------------------------
# 기능: 리버스 프록시 직전 피어 IP(쉼표 구분). X-Forwarded-For 등에서 실제 클라이언트 IP 추출 시 신뢰.
# Production: 필수(프록시 뒤에 둘 경우). 비어 있으면 부팅 실패. Nginx/Cloudflare 등 직전 IP 입력.
#            프록시 뒤에 두지 않는 배포만 TRUSTED_PROXY_SKIP_FAST=1 로 부팅 허용.
TRUSTED_PROXY_IPS=

# 기능: 1 이면 production 에서 TRUSTED_PROXY_IPS 가 비어 있어도 부팅 허용. 프록시 미사용 시만 1.
# Production: 선택. 기본 0(비어 있으면 실패).
# TRUSTED_PROXY_SKIP_FAST=

# ------------------------------------------------------------------------------
# 3단계 - Redis·Celery·Internal API
# ------------------------------------------------------------------------------
# 기능: Redis 연결 URL. 세션·캐시·레이트리밋·Celery broker 등에 사용.
# Production: 필수. 비어 있으면 부팅 실패.
REDIS_URL=

# 기능: Celery broker/result_backend 전용 Redis URL. 비우면 REDIS_URL 사용.
# Production: 선택. 워커 시작 시 -Q critical,crawl,ai 등 큐 지정 필수.
# 로컬에서만 워커 돌릴 때: redis://localhost:6379/1 로 두면 클라우드 워커가 작업을 가져가지 않음. (docs/runbooks/local-worker-only.md)
# REDIS_CELERY_URL=redis://redis:6379/1
# CELERY_REQUIRE_SEPARATE_REDIS_URL=true

# 기능: Redis blocklist 장애 시 동작. true=인증 거부(Fail-Closed), false=서명만 검증 후 통과.
# Production (APP_ENTRY=api): 필수 true. 미설정 또는 false 시 API 부팅 실패. 워커(APP_ENTRY=celery)는 영향 없음.
REDIS_BLOCKLIST_FAIL_CLOSED=

# 기능: 레이트리밋 시 Redis 필수 여부. true 면 Redis 없/장애 시 503. 멀티 인스턴스 시 true 권장.
# Production: 권장 true.
API_RATE_LIMIT_REQUIRE_REDIS=true
REDIS_BLOCKLIST_MAX_CONNECTIONS=

# 기능: /internal/* 호출 시 사용하는 선인증 시크릿. 크롤 트리거 등 내부 API 보안.
# Production: 필수. 비어 있으면 부팅 실패. 외부에 노출되지 않는 강한 값 설정.
CRAWL_TRIGGER_SECRET=

# 기능: /internal/* IP당 분당 요청 제한. Redis 남용·DDoS 완화.
# Production: 선택. 기본값 있음.
INTERNAL_PREAUTH_RATE_LIMIT_PER_MINUTE=30
INTERNAL_AUTH_FAIL_RATE_LIMIT_PER_MINUTE=10

# 기능: 단과대별 크롤 시작 시간 분산(초). 0=동시, 300=5분 간격. Thundering Herd 방지.
# Production: 선택.
CRAWL_TRIGGER_STAGGER_SECONDS=300
REDIS_TRIGGER_IDEMPOTENCY_REQUIRED=true
REDIS_CRAWL_SEEN_REQUIRED=true

# 기능: 클라이언트 IP 해석 시 로그 샘플 비율(0.0~1.0). 운영에서는 0 권장.
# Production: 선택.
CLIENT_IP_RESOLUTION_LOG_SAMPLE_RATE=0.0

# 기능: 크롤러 요청/페이지 간 최소 대기(초). 대상 서버 부하·IP 차단 완화.
# Production: 선택.
POLITE_DELAY_SECONDS=1.0
CRAWL_PAGE_TIMEOUT_SECONDS=
CRAWL_HTTP_RETRY_MAX_ATTEMPTS=3
CRAWL_HTTP_RETRY_BACKOFF_BASE_SECONDS=0.5
CRAWL_HTTP_RETRY_BACKOFF_MAX_SECONDS=8.0
# Comma-separated hostnames for WAF-specific 403 retry (example: engineering.yonsei.ac.kr,medicine.yonsei.ac.kr)
CRAWL_RETRY_403_HOSTS=
CRAWL_UPSERT_CHUNK_SIZE=
CRAWL_COLLECT_SYNC_MAX_WORKERS=3
CRAWL_COLLECT_IN_FLIGHT_LIMIT=100
CRAWL_MAX_LINKS_PER_RUN=10000
CRAWL_COLLECT_ASYNC_CONCURRENCY=5

# Dispatcher-side optional backpressure knobs
CELERY_DISPATCH_MEMORY_SOFT_LIMIT_MB=1024
CELERY_DISPATCH_BACKPRESSURE_STEP_SECONDS=30
CELERY_DISPATCH_BACKPRESSURE_MAX_SECONDS=300

# 기능: GET /internal/metrics 허용 IP(쉼표 구분). 비우면 모든 IP 차단. Prometheus 스크래핑 제한.
# Production: 선택. 메트릭 수집 시 Prometheus 서버 IP 등 설정.
METRICS_ALLOWED_IPS=

# ------------------------------------------------------------------------------
# Content 스풀 (업로드 실패 시 보관)
# ------------------------------------------------------------------------------
# 기능: 본문 업로드 실패 시 정책. fail=실패 시 에러, allow_none=스풀 없이 무시 등.
# Production: 미설정 시 자동으로 'fail' 적용. 설정 시 반드시 'fail' 이어야 부팅 성공.
# CONTENT_UPLOAD_FAILURE_POLICY=

# 기능: 스풀 디렉터리(local) 또는 S3. local | s3.
# Production: 기본 local. local 이면 CONTENT_SPOOL_ALLOW_EPHEMERAL=true 필수(휘발 디스크 허용).
# CONTENT_SPOOL_DIR=
# CONTENT_SPOOL_BACKEND=local

# 기능: production + local 스풀 시 휘발성 디스크 허용. Railway 등 컨테이너는 디스크 휘발성.
# Production: CONTENT_SPOOL_BACKEND=local 이면 필수. 반드시 true 로 설정해야 부팅 성공(자동 대입 없음).
# CONTENT_SPOOL_ALLOW_EPHEMERAL=false
# CONTENT_SPOOL_S3_PREFIX=content-spool
# CONTENT_SPOOL_MAX_RETRIES=5

# 기능: 읽기 캐시 TTL(초)·키 접두사. crawl-stats 등.
# Production: 선택.
# READ_CACHE_TTL_SECONDS=60
# READ_CACHE_KEY_PREFIX=read_cache:
# Soft TTL + mutex (crawl-stats stampede 방지). soft < TTL 강제.
# READ_CACHE_SOFT_TTL_SECONDS=20
# READ_CACHE_LOCK_TTL_SECONDS=10
# READ_CACHE_WAIT_FOR_FRESH_MS=1000
# 상세 페이지 read-through 캐시 (scrape_*_detail만, 목록 미캐시). Redis 장애 시 fail-open.
# CRAWL_DETAIL_CACHE_ENABLED=false
# CRAWL_DETAIL_CACHE_TTL_SECONDS=300
# CRAWL_DETAIL_CACHE_KEY_PREFIX=dicee:crawl:detail:
# DEGRADED_FAILURE_THRESHOLD=3
# DEGRADED_RECOVERY_SUCCESS_COUNT=5

# ------------------------------------------------------------------------------
# 로깅·개인정보 보호
# ------------------------------------------------------------------------------
# 기능: 로그·Sentry 에서 user_id 를 HMAC 으로 해싱할 때 쓰는 비밀키. 재식별 위험 감소.
# Production: 필수. 비어 있으면 부팅 실패(Fail-Fast). API/워커 런타임의 compute_user_id_hash도 동일 조건에서 예외(약한 SHA256-only 폴백 없음). APP_ENTRY=migrate만 예외.
USER_ID_HMAC_KEY=
USER_ID_HMAC_KEY_VERSION=v1

# 기능: API 진입점에서 클라이언트 IP 해싱용 키. 로그에 원본 IP 노출 방지.
# Production: 필수(API 진입점). 비어 있으면 부팅 실패.
IP_HMAC_KEY=

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------
# 기능: CORS 허용 오리진(쉼표 구분). 비우면 모든 오리진 허용 가능(보안 취약).
# Production: 권장. 프론트 도메인만 명시. 예: https://app.example.com,https://beta.example.com
ALLOWED_ORIGINS=
